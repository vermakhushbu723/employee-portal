APP_NAME="Employee Portal"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Kolkata
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=employee_portal
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=480
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Portal settings
PORTAL_COMPANY="Employee Portal"
LEAVE_DEDUCTION_PER_DAY=500

# Daily work report e-mails (Hostinger: create a mailbox in hPanel → Emails, then fill this in)
MAIL_MAILER=log
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=reports@ignitesources.in
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=reports@ignitesources.in
MAIL_FROM_NAME="Employee Portal"
REPORT_MAIL_ENABLED=true
REPORT_MAIL_CC_ADMINS=true
